# Copier vers .env (hors zone publique, permissions 0600). Ne jamais committer .env.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://rendezvous.example.org
APP_TIMEZONE=Europe/Paris

# MySQL 8 / MariaDB
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rendezvous_manager
DB_USER=
DB_PASSWORD=
# TLS : disabled | required | verify (vérifie le certificat et l'identité du serveur)
DB_SSL_MODE=verify
DB_SSL_CA=

# Base dédiée aux tests (jamais la production)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=rendezvous_manager_test
TEST_DB_USER=
TEST_DB_PASSWORD=

# SMTP optionnel
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Web Push (clés VAPID générées à l'installation)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
COOKIE_SECURE=true
